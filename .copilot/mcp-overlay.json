{
  "mcpServers": {
    "gitea": {
      "type": "stdio",
      "command": "zsh",
      "args": [
        "${HOME}/Projects/gitea.sasu.org/infra2/agent-docs/scripts/mcp/run_gitea_mcp.sh"
      ],
      "env": {
        "GITEA_AGENT": "copilot",
        "GITEA_PROJECT_DIR": "${HOME}/Projects/github.com/sasuw/camilla",
        "GITEA_HOST_SOURCE": "project"
      },
      "tools": [
        "*"
      ]
    }
  }
}
