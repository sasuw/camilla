{
  "mcpServers": {
    "dart-mcp": {
      "command": "dart",
      "args": [
        "mcp-server",
        "--force-roots-fallback"
      ]
    },
    "gitea": {
      "command": "sh",
      "args": [
        "-c",
        "exec env GITEA_PROJECT_DIR=\"$HOME\"'/Projects/github.com/sasuw/camilla' 'zsh' \"$HOME\"'/Projects/gitea.sasu.org/infra2/agent-docs/scripts/mcp/run_gitea_mcp.sh'"
      ],
      "env": {
        "GITEA_AGENT": "antigravity",
        "GITEA_HOST_SOURCE": "project"
      }
    }
  }
}
