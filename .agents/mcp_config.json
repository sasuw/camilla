{
  "mcpServers": {
    "dart-mcp": {
      "command": "dart",
      "args": [
        "mcp-server",
        "--force-roots-fallback"
      ]
    },
    "filesystem": {
      "command": "sh",
      "args": [
        "-c",
        "exec \"$HOME\"'/Projects/gitea.sasu.org/infra2/agent-docs/scripts/mcp/run_npx_mcp.sh' '@modelcontextprotocol/server-filesystem' \"$HOME\"'/Projects/github.com/sasuw/camilla'"
      ]
    },
    "git": {
      "command": "sh",
      "args": [
        "-c",
        "exec 'uvx' '--with' 'mcp<2' 'mcp-server-git' '--repository' \"$HOME\"'/Projects/github.com/sasuw/camilla'"
      ]
    },
    "gitea": {
      "command": "sh",
      "args": [
        "-c",
        "exec 'zsh' \"$HOME\"'/Projects/gitea.sasu.org/infra2/agent-docs/scripts/mcp/run_gitea_mcp.sh'"
      ],
      "env": {
        "GITEA_AGENT": "antigravity",
        "GITEA_HOST": "https://gitea.sasu.org"
      }
    }
  }
}
